# --- LLM / embeddings ---
# Providers: ollama | openai | anthropic (chat), ollama | openai (embeddings).
# Switching provider is an env-only change; see app/ai/factory.py.
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
LLM_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# Only needed for the matching cloud provider. For a FREE cloud setup use a
# Google AI Studio key with Gemini's OpenAI-compatible endpoint:
#   OPENAI_API_KEY=<AI Studio key>
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-2.0-flash-lite
#   EMBEDDING_MODEL=text-embedding-004
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# --- Job queue ---
# Redis used by RQ for async forecast jobs (API enqueues, worker executes).
#
# This project NEVER assumes port 6379 is free — it is commonly occupied by
# other local services. The checked-in default for this repo is 6380.
# REDIS_PORT is the host port used by docker-compose and scripts/check-ports;
# REDIS_URL is what the app connects to — keep the two in sync.
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# --- API access ---
# Requests per minute per API key (fixed window, Redis-backed). 0 disables.
# RATE_LIMIT_PER_MINUTE covers POST /forecasts submissions;
# RATE_LIMIT_GET_PER_MINUTE covers cheap status reads (GET), sized so a
# client polling every few seconds never starves its submission budget.
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_GET_PER_MINUTE=120

# --- Database ---
# Leave DATABASE_URL empty to use the MySQL settings below (with SQLite
# fallback per ALLOW_SQLITE_FALLBACK). Set it to force a specific engine,
# e.g. sqlite:///./dev.db or mysql+pymysql://user:pass@host:3306/forecastgpt.
DATABASE_URL=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=forecastgpt
# When false, an unreachable MySQL aborts startup instead of falling back.
ALLOW_SQLITE_FALLBACK=true

# --- Data / scraping ---
DATA_DIR=data/cache
USER_AGENT=ForecastGPT/1.0
