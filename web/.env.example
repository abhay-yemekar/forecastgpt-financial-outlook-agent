# Optional frontend build env (Vite). Copy to web/.env for local dev.
# Not needed when the API serves them: the app reads GET /config at boot
# (backend SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY). Set these only to point
# a local build at a Supabase project without configuring the backend.
# Values: supabase.com → Project Settings → API Keys (publishable key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
